#!/bin/sh

# Executado pelo greetd (usuário `greeter`). Sobe o labwc - compositor
# Wayland stacking, com suporte a wlr-layer-shell - e dentro dele o
# QuickShell com a config "orzhov-greeter" (instalada em
# /etc/xdg/quickshell/orzhov-greeter).
#
# Troque o wallpaper sem mexer no QML: exporte ORZHOV_BACKGROUND antes do
# labwc subir (ex: outro script que gere esse env a partir de um arquivo
# de config do sistema).

set -e

if [ -f /etc/greetd/orzhov.env ]; then
    . /etc/greetd/orzhov.env
fi

export QT_QPA_PLATFORM=wayland
export ORZHOV_BACKGROUND="${ORZHOV_BACKGROUND:-}"

# descomente para depurar problemas de inicialização:
# exec labwc -S "quickshell -c orzhov-greeter" 2>>/var/log/orzhov-greeter.log

exec labwc -S "quickshell -c orzhov-greeter"
